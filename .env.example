# Copy to .env and fill in. Every CAGENT_* name matches an AgentConfig field,
# and environment variables override both .cagent.toml files.

# ---------------------------------------------------------------------------
# Using a third-party or self-hosted endpoint
# ---------------------------------------------------------------------------
# Any OpenAI-compatible gateway works — you do NOT need a matching preset.
# Set the endpoint, the model name it expects, and the key:
#
#   CAGENT_BASE_URL=https://your-gateway.example.com/v1
#   CAGENT_MODEL=whatever-model-that-gateway-serves
#   CAGENT_API_KEY=your-key
#
# base_url is used verbatim; "/chat/completions" (or "/messages" on the
# Anthropic wire) is appended. So include the version segment if your provider
# publishes one — a URL ending in ".../v1" is right for most gateways, and
# omitting it is the usual cause of a 404 on the first request. A trailing
# slash is fine either way.
#
# CAGENT_WIRE picks the request format: "openai" (default for a custom
# base_url) or "anthropic". Set it only if your endpoint speaks the Anthropic
# Messages API rather than OpenAI Chat Completions.
# CAGENT_WIRE=openai
#
# Check what got resolved, with the key masked:  cagent --show-config
# ---------------------------------------------------------------------------

# Which preset to use: deepseek | openai | anthropic | moonshot | dashscope | openrouter | ollama
# A preset just supplies a default base_url, model, and wire; CAGENT_BASE_URL
# overrides the preset's endpoint, so the two can be combined.
CAGENT_PROVIDER=deepseek

# Override the preset's default model. Leave unset to take the preset default.
# CAGENT_MODEL=deepseek-chat

# Override the endpoint. Required for any provider that is not a preset.
# CAGENT_BASE_URL=https://api.deepseek.com/v1

# Generic key, checked before any vendor-specific variable below.
CAGENT_API_KEY=your-api-key-here

# Vendor-specific fallbacks: used when CAGENT_API_KEY is unset and the
# provider matches. Only the one for your provider needs a value.
# DEEPSEEK_API_KEY=your-api-key-here
# OPENAI_API_KEY=your-api-key-here
# ANTHROPIC_API_KEY=your-api-key-here
# MOONSHOT_API_KEY=your-api-key-here
# DASHSCOPE_API_KEY=your-api-key-here
# OPENROUTER_API_KEY=your-api-key-here
# OLLAMA_API_KEY=not-required-for-local-ollama

# suggest = confirm every mutation, file writes included
# auto-edit = writes inside the workspace run free, shell commands still confirmed
# full-auto = only destructive calls are confirmed
CAGENT_APPROVAL_MODE=auto-edit

# Hard ceiling on tool-use iterations for a single request.
CAGENT_MAX_STEPS=40
