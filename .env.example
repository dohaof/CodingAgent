# Copy to .env and fill in, or just export these in your shell. Every CAGENT_*
# name matches an AgentConfig field, and environment variables override both
# .cagent.toml files.

# ---------------------------------------------------------------------------
# The endpoint: three required settings, one optional
# ---------------------------------------------------------------------------
# Anything OpenAI-compatible works — a vendor API, a gateway, a proxy, or a
# local server. There is no "provider" name to choose, on purpose: that would
# mean a built-in table of vendor model names, and those go stale within months
# and fail as a remote 404 that explains nothing.

# Used verbatim, with /chat/completions appended (/messages on the anthropic
# wire). Include the version segment your provider publishes — usually /v1.
# Omitting it is the usual cause of a 404 on the first request.
CAGENT_BASE_URL=https://api.example.com/v1

# The model name your endpoint expects. Required; nothing is guessed.
CAGENT_MODEL=the-model-your-endpoint-serves

CAGENT_API_KEY=your-key-here

# Request format: "openai" (Chat Completions, the default) or "anthropic"
# (the Messages API). Set this only if your endpoint speaks the latter.
# CAGENT_WIRE=openai

# For a local server with no authentication (Ollama, llama.cpp), pass --no-key
# on the command line, or set requires_key = false in .cagent.toml.

# If you already have a vendor key exported — OPENAI_API_KEY,
# ANTHROPIC_API_KEY, DEEPSEEK_API_KEY, MOONSHOT_API_KEY, DASHSCOPE_API_KEY,
# OPENROUTER_API_KEY, GROQ_API_KEY, TOGETHER_API_KEY, MISTRAL_API_KEY — it is
# picked up automatically and need not be duplicated. That is a convenience
# only: it says nothing about which endpoint is called.

# Check what resolved, with the key masked:  cagent --show-config
# ---------------------------------------------------------------------------

# suggest = confirm every mutation, file writes included
# auto-edit = writes inside the workspace run free, shell commands still confirmed
# full-auto = only destructive calls are confirmed
CAGENT_APPROVAL_MODE=auto-edit

# Hard ceiling on tool-use iterations for a single request.
CAGENT_MAX_STEPS=40
