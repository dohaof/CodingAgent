{
  "name": "cagent-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Electron desktop client for cagent",
  "main": "dist-electron/main.js",
  "bin": {
    "cagent-web": "bin/cagent-web.cjs"
  },
  "files": [
    "bin",
    "dist",
    "dist-electron",
    "electron",
    "index.html",
    "package.json"
  ],
  "scripts": {
    "dev": "concurrently -k \"tsc -p tsconfig.electron.json --watch\" \"vite --host 127.0.0.1\" \"wait-on dist-electron/main.js tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist-electron/main.js\"",
    "build": "tsc -p tsconfig.electron.json && tsc --noEmit && vite build",
    "start": "electron dist-electron/main.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "electron": "^44.1.0",
    "lucide": "^0.468.0",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  }
}
